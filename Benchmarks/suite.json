{
  "format": "noqeri-benchmark-suite-v1",
  "policy": {
    "warmupRuns": 3,
    "measurementRuns": 10,
    "timeoutSeconds": 60,
    "releaseRegressionPercent": 8,
    "informationalLanguages": ["c", "cpp", "rust", "zig", "go"],
    "claimPolicy": "Cross-language results are descriptive. No faster-than claim is permitted without a published result set, hardware/software metadata, confidence data and reproducible sources."
  },
  "workloads": [
    {"id":"binary-trees","metric":"wall-ms","kind":"cpu-memory","size":"depth=18"},
    {"id":"json","metric":"wall-ms","kind":"parse-serialize","size":"25MiB deterministic corpus"},
    {"id":"regex","metric":"wall-ms","kind":"text","size":"100000 matches"},
    {"id":"http-server","metric":"requests-sec","kind":"network","size":"100 connections / 30s"},
    {"id":"filesystem","metric":"wall-ms","kind":"io","size":"10000 4KiB files"},
    {"id":"database","metric":"transactions-sec","kind":"storage","size":"100000 CRUD operations"},
    {"id":"matrix","metric":"wall-ms","kind":"numeric","size":"512x512 multiply"},
    {"id":"allocation","metric":"allocations-sec","kind":"memory","size":"500000 objects"},
    {"id":"strings","metric":"wall-ms","kind":"text","size":"100MiB transform"},
    {"id":"sorting","metric":"wall-ms","kind":"cpu-memory","size":"1000000 i64"},
    {"id":"startup","metric":"wall-ms","kind":"latency","size":"empty program"},
    {"id":"compilation","metric":"wall-ms","kind":"compiler","size":"standard corpus"}
  ]
}
