    {"id":"regex","group":"text","threshold_percent":8},
    {"id":"http-server","group":"network","threshold_percent":10},
    {"id":"filesystem","group":"io","threshold_percent":10},
    {"id":"database","group":"storage","threshold_percent":10},
    {"id":"matrix","group":"numeric","threshold_percent":8},
    {"id":"allocation","group":"runtime","threshold_percent":8},
    {"id":"strings","group":"text","threshold_percent":8},
    {"id":"sorting","group":"collections","threshold_percent":8},
