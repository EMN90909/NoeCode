{
  "version": 3,
  "configurePresets": [
    {"name":"debug","displayName":"noqeri Debug","generator":"Ninja","binaryDir":"${sourceDir}/build/debug","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug","BUILD_TESTING":"ON"}},
    {"name":"release","displayName":"noqeri Release","generator":"Ninja","binaryDir":"${sourceDir}/build/release","cacheVariables":{"CMAKE_BUILD_TYPE":"Release","BUILD_TESTING":"ON"}}
  ],
  "buildPresets": [
    {"name":"debug","configurePreset":"debug"},
    {"name":"release","configurePreset":"release"}
  ],
  "testPresets": [
    {"name":"debug","configurePreset":"debug","output":{"outputOnFailure":true}},
    {"name":"release","configurePreset":"release","output":{"outputOnFailure":true}}
  ]
}
