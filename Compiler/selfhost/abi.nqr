module noqeri.compiler.selfhost.abi
import "targets.nqr"

export function nqAbiIntegerArgRegisters(target: int): int { if target == nqTargetWindowsX64() { return 4 } if target == nqTargetWindowsArm64() { return 8 } if target == nqTargetLinuxX64() || target == nqTargetMacX64() { return 6 } if target == nqTargetLinuxArm64() || target == nqTargetMacArm64() { return 8 } return 0 }
export function nqAbiFloatArgRegisters(target: int): int { if target == nqTargetWindowsX64() { return 4 } if target == nqTargetWindowsArm64() { return 8 } if target == nqTargetLinuxX64() || target == nqTargetMacX64() { return 8 } if target == nqTargetLinuxArm64() || target == nqTargetMacArm64() { return 8 } return 0 }
export function nqAbiReturnRegisters(target: int): int { if nqTargetValid(target) { return 2 } return 0 }
export function nqAbiStackAlignmentBytes(target: int): usize { return nqTargetStackAlignment(target) }
export function nqAbiWindowsShadowBytes(target: int): usize { if target == nqTargetWindowsX64() { return 32 as usize } return 0 as usize }
export function nqAbiRedZoneBytes(target: int): usize { if target == nqTargetLinuxX64() || target == nqTargetMacX64() { return 128 as usize } return 0 as usize }
export function nqAbiSretThresholdBytes(target: int): usize { if nqTargetValid(target) { return 16 as usize } return 0 as usize }
export function nqAbiCalleeSavedIntegerCount(target: int): int { if target == nqTargetWindowsX64() { return 8 } if target == nqTargetLinuxX64() || target == nqTargetMacX64() { return 6 } if nqTargetArchitecture(target) == nqArchArm64() { return 11 } return 0 }
