module noqeri.compiler.selfhost.backend
import "nir.nqr"
import "targets.nqr"
import "object_formats.nqr"
export function nqBackendOk(): isize { return 0 }
export function nqBackendUnsupportedTarget(): isize { return -400 }
export function nqBackendUnsupportedOpcode(): isize { return -401 }
export function nqBackendInvalidAbi(): isize { return -402 }
export function nqBackendTargetReady(target: int): bool { return nqTargetValid(target) && nqTargetPointerBytes(target) == 8 as usize }
export function nqBackendOpcodeReady(opcode: int): bool { return nqNirOpcodeValid(opcode) }
export function nqBackendValidate(target: int, opcode: int): isize { if !nqBackendTargetReady(target) { return nqBackendUnsupportedTarget() } if !nqBackendOpcodeReady(opcode) { return nqBackendUnsupportedOpcode() } return nqBackendOk() }
export function nqBackendPrologueStackAlign(target: int): usize { return nqTargetStackAlignment(target) }
export function nqBackendNeedsShadowSpace(target: int): bool { return nqTargetAbi(target) == nqAbiWin64() }
export function nqBackendShadowSpaceBytes(target: int): usize { if nqBackendNeedsShadowSpace(target) { return 32 as usize } return 0 as usize }
export function nqBackendRedZoneBytes(target: int): usize { if nqTargetAbi(target) == nqAbiSysV64() && nqTargetArchitecture(target) == nqArchX64() { return 128 as usize } return 0 as usize }
