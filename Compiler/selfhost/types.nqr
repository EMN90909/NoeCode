module noqeri.compiler.selfhost.types

export function nqCompilerPrimitiveTypeWidth(code: int): usize {
    if code == 1 || code == 2 { return 1 as usize }
    if code == 3 || code == 4 { return 2 as usize }
    if code == 5 || code == 6 { return 4 as usize }
    if code == 7 || code == 8 || code == 9 || code == 10 || code == 11 { return 8 as usize }
    return 0 as usize
}

export function nqCompilerTypeIsInteger(code: int): bool {
    return code >= 1 && code <= 11
}

export function nqCompilerTypeIsSigned(code: int): bool {
    return code == 2 || code == 4 || code == 6 || code == 8 || code == 10 || code == 11
}

export function nqCompilerCanImplicitWiden(fromCode: int, toCode: int): bool {
    if !nqCompilerTypeIsInteger(fromCode) || !nqCompilerTypeIsInteger(toCode) { return false }
    if nqCompilerTypeIsSigned(fromCode) != nqCompilerTypeIsSigned(toCode) { return false }
    return nqCompilerPrimitiveTypeWidth(fromCode) <= nqCompilerPrimitiveTypeWidth(toCode)
}
