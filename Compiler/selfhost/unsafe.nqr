module noqeri.compiler.selfhost.unsafe
import "lexer.nqr"

export function nqUnsafeOk(): isize { return 0 }
export function nqUnsafeRequired(): isize { return -140 }
export function nqUnsafeMalformed(): isize { return -141 }

export function nqUnsafeKeywordAt(source: []u8, start: usize, word: []u8): bool {
    if start + len(word) > len(source) { return false }
    let index: usize = 0 as usize
    while index < len(word) {
        if source[start + index] != word[index] { return false }
        index = index + 1 as usize
    }
    if start > 0 as usize && nqCompilerIsIdentifierContinue(source[start - 1 as usize]) { return false }
    if start + len(word) < len(source) && nqCompilerIsIdentifierContinue(source[start + len(word)]) { return false }
    return true
}

export function nqUnsafeIsNamedOperation(source: []u8, start: usize): bool {
    if nqUnsafeKeywordAt(source, start, slice([104 as u8,111 as u8,115 as u8,116 as u8])) { return true }
    if nqUnsafeKeywordAt(source, start, slice([97 as u8,98 as u8,105 as u8])) { return true }
    if nqUnsafeKeywordAt(source, start, slice([97 as u8,115 as u8,109 as u8])) { return true }
    if nqUnsafeKeywordAt(source, start, slice([105 as u8,110 as u8,116 as u8,114 as u8,105 as u8,110 as u8,115 as u8,105 as u8,99 as u8])) { return true }
    return false
}

export function nqUnsafePreviousSignificant(source: []u8, start: usize): u8 {
    if start == 0 as usize { return 0 as u8 }
    let index: usize = start
    while index > 0 as usize {
        index = index - 1 as usize
        let value: u8 = source[index]
        if value != 32 as u8 && value != 9 as u8 && value != 10 as u8 && value != 13 as u8 { return value }
    }
    return 0 as u8
}

export function nqUnsafeLooksLikeDereference(source: []u8, start: usize): bool {
    if start >= len(source) || source[start] != 42 as u8 { return false }
    let next: usize = nqCompilerSkipTrivia(source, start + 1 as usize)
    if next >= len(source) || !(nqCompilerIsIdentifierStart(source[next]) || source[next] == 40 as u8) { return false }
    let previous: u8 = nqUnsafePreviousSignificant(source, start)
    if previous == 0 as u8 || previous == 61 as u8 || previous == 40 as u8 || previous == 123 as u8 || previous == 91 as u8 || previous == 44 as u8 || previous == 59 as u8 { return true }

    let scan: usize = 0 as usize
    let last: usize = 0 as usize
    while scan < start {
        let token: usize = nqCompilerSkipTrivia(source, scan)
        if token >= start { break }
        let end: usize = nqCompilerTokenEnd(source, token)
        if end >= start { break }
        last = token
        scan = end
    }
    return nqUnsafeKeywordAt(source, last, slice([114 as u8,101 as u8,116 as u8,117 as u8,114 as u8,110 as u8]))
}

export function nqUnsafeBoundaryCheck(source: []u8): isize {
    let index: usize = nqCompilerSkipTrivia(source, 0 as usize)
    let braceDepth: int = 0
    let unsafeDepth: int = -1
    let pendingUnsafe: bool = false

    while index < len(source) {
        if nqUnsafeKeywordAt(source, index, slice([117 as u8,110 as u8,115 as u8,97 as u8,102 as u8,101 as u8])) {
            if pendingUnsafe { return nqUnsafeMalformed() }
            pendingUnsafe = true
            index = nqCompilerSkipTrivia(source, nqCompilerTokenEnd(source, index))
            if index >= len(source) || source[index] != 123 as u8 { return nqUnsafeMalformed() }
        }

        if index >= len(source) { break }
        let value: u8 = source[index]

        if value == 123 as u8 {
            braceDepth = braceDepth + 1
            if pendingUnsafe {
                if unsafeDepth < 0 { unsafeDepth = braceDepth }
                pendingUnsafe = false
            }
        } else if value == 125 as u8 {
            if unsafeDepth == braceDepth { unsafeDepth = -1 }
            braceDepth = braceDepth - 1
        } else if unsafeDepth < 0 {
            if nqUnsafeIsNamedOperation(source, index) {
                let callEnd: usize = nqCompilerSkipTrivia(source, nqCompilerTokenEnd(source, index))
                if callEnd < len(source) && source[callEnd] == 40 as u8 { return nqUnsafeRequired() }
            }

            if nqUnsafeKeywordAt(source, index, slice([97 as u8,115 as u8])) {
                let castTarget: usize = nqCompilerSkipTrivia(source, nqCompilerTokenEnd(source, index))
                if castTarget < len(source) && source[castTarget] == 42 as u8 { return nqUnsafeRequired() }
            }

            if nqUnsafeLooksLikeDereference(source, index) { return nqUnsafeRequired() }
        }

        let next: usize = nqCompilerTokenEnd(source, index)
        if next <= index { return nqUnsafeMalformed() }
        index = nqCompilerSkipTrivia(source, next)
    }

    if pendingUnsafe || unsafeDepth >= 0 { return nqUnsafeMalformed() }
    return nqUnsafeOk()
}

export function nqUnsafeBoundaryOk(source: []u8): bool {
    return nqUnsafeBoundaryCheck(source) == nqUnsafeOk()
}
