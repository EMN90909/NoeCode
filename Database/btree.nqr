module noqeri.database.btree

export function dbBtreeDefaultOrder():usize{return 32 as usize}
export function dbBtreeMinOrder():usize{return 4 as usize}
export function dbBtreeMaxOrder():usize{return 256 as usize}
export function dbBtreeLeafKind():u8{return 1 as u8}
export function dbBtreeInternalKind():u8{return 2 as u8}

export function dbBtreeOrderValid(order:usize):bool{
    return order>=dbBtreeMinOrder()&&order<=dbBtreeMaxOrder()
}

export function dbBtreeLowerBound(keys:*i64,count:usize,key:i64):usize{
    let low:usize=0 as usize
    let high:usize=count
    while low<high{
        let middle:usize=low+(high-low)/2 as usize
        if keys[middle]<key{low=middle+1 as usize}else{high=middle}
    }
    return low
}

export function dbBtreeFind(keys:*i64,count:usize,key:i64):isize{
    let at:usize=dbBtreeLowerBound(keys,count,key)
    if at<count&&keys[at]==key{return at as isize}
    return -1 as isize
}

// Inserts into one non-full leaf. Keys stay sorted and duplicate keys are rejected.
export function dbBtreeLeafInsert(keys:*i64,rows:*u64,count:usize,order:usize,key:i64,row:u64):isize{
    if !dbBtreeOrderValid(order)||count>=order-1 as usize{return -1 as isize}
    let at:usize=dbBtreeLowerBound(keys,count,key)
    if at<count&&keys[at]==key{return -2 as isize}
    let index:usize=count
    while index>at{
        keys[index]=keys[index-1 as usize]
        rows[index]=rows[index-1 as usize]
        index=index-1 as usize
    }
    keys[at]=key
    rows[at]=row
    return at as isize
}

export function dbBtreeLeafSplitPoint(count:usize):usize{
    return count/2 as usize
}

// Splits a full sorted leaf into caller-owned left/right pages.
// Returns the first key of the right page, which is the separator copied into the parent.
export function dbBtreeSplitLeaf(
    sourceKeys:*i64,
    sourceRows:*u64,
    count:usize,
    leftKeys:*i64,
    leftRows:*u64,
    rightKeys:*i64,
    rightRows:*u64,
    order:usize
):i64{
    if !dbBtreeOrderValid(order)||count<2 as usize||count>order{return 0 as i64}
    let split:usize=dbBtreeLeafSplitPoint(count)
    let index:usize=0 as usize
    while index<split{
        leftKeys[index]=sourceKeys[index]
        leftRows[index]=sourceRows[index]
        index=index+1 as usize
    }
    index=split
    while index<count{
        let rightIndex:usize=index-split
        rightKeys[rightIndex]=sourceKeys[index]
        rightRows[rightIndex]=sourceRows[index]
        index=index+1 as usize
    }
    return rightKeys[0]
}

export function dbBtreeLeftCountAfterSplit(count:usize):usize{return dbBtreeLeafSplitPoint(count)}
export function dbBtreeRightCountAfterSplit(count:usize):usize{return count-dbBtreeLeafSplitPoint(count)}

// Internal-node routing chooses the first child whose upper separator is greater than key.
export function dbBtreeChildIndex(separators:*i64,keyCount:usize,key:i64):usize{
    let index:usize=0 as usize
    while index<keyCount&&key>=separators[index]{index=index+1 as usize}
    return index
}

export function dbBtreeNodeShapeValid(kind:u8,keyCount:usize,childCount:usize,order:usize):bool{
    if !dbBtreeOrderValid(order)||keyCount>=order{return false}
    if kind==dbBtreeLeafKind(){return childCount==0 as usize}
    if kind==dbBtreeInternalKind(){return childCount==keyCount+1 as usize}
    return false
}
