module noqeri.database.sql

// SQL compatibility contract for NoqeriDB. Parsing/execution is host-backed
// until the self-host query parser reaches feature parity with the bootstrap
// database engine. Parameters are passed separately from SQL text so callers
// do not have to construct statements through string concatenation.
extern function dbHostSqlExec(database: usize, sql: string, parametersJson: string): isize
extern function dbHostSqlQuery(database: usize, sql: string, parametersJson: string): usize
extern function dbHostSqlRowsNext(rows: usize): bool
extern function dbHostSqlRowsColumnCount(rows: usize): usize
extern function dbHostSqlRowsColumnName(rows: usize, column: usize): string
extern function dbHostSqlRowsText(rows: usize, column: usize): string
extern function dbHostSqlRowsClose(rows: usize): void
extern function dbHostSqlPrepare(database: usize, sql: string): usize
extern function dbHostSqlPreparedExec(statement: usize, parametersJson: string): isize
extern function dbHostSqlPreparedQuery(statement: usize, parametersJson: string): usize
extern function dbHostSqlPreparedClose(statement: usize): void

export function sqlHandleValid(handle: usize): bool { return handle != 0 as usize }
export function sqlParametersNone(): string { return "[]" }

export function sqlExec(database: usize, sql: string, parametersJson: string): isize {
    if !sqlHandleValid(database) { return -1 }
    unsafe { return dbHostSqlExec(database, sql, parametersJson) }
}

export function sqlQuery(database: usize, sql: string, parametersJson: string): usize {
    if !sqlHandleValid(database) { return 0 as usize }
    unsafe { return dbHostSqlQuery(database, sql, parametersJson) }
}

export function sqlRowsNext(rows: usize): bool {
    if !sqlHandleValid(rows) { return false }
    unsafe { return dbHostSqlRowsNext(rows) }
}

export function sqlRowsColumnCount(rows: usize): usize {
    if !sqlHandleValid(rows) { return 0 as usize }
    unsafe { return dbHostSqlRowsColumnCount(rows) }
}

export function sqlRowsColumnName(rows: usize, column: usize): string {
    if !sqlHandleValid(rows) { return "" }
    unsafe { return dbHostSqlRowsColumnName(rows, column) }
}

export function sqlRowsText(rows: usize, column: usize): string {
    if !sqlHandleValid(rows) { return "" }
    unsafe { return dbHostSqlRowsText(rows, column) }
}

export function sqlRowsClose(rows: usize): void {
    if sqlHandleValid(rows) {
        unsafe { dbHostSqlRowsClose(rows) }
    }
}

export function sqlPrepare(database: usize, sql: string): usize {
    if !sqlHandleValid(database) { return 0 as usize }
    unsafe { return dbHostSqlPrepare(database, sql) }
}

export function sqlPreparedExec(statement: usize, parametersJson: string): isize {
    if !sqlHandleValid(statement) { return -1 }
    unsafe { return dbHostSqlPreparedExec(statement, parametersJson) }
}

export function sqlPreparedQuery(statement: usize, parametersJson: string): usize {
    if !sqlHandleValid(statement) { return 0 as usize }
    unsafe { return dbHostSqlPreparedQuery(statement, parametersJson) }
}

export function sqlPreparedClose(statement: usize): void {
    if sqlHandleValid(statement) {
        unsafe { dbHostSqlPreparedClose(statement) }
    }
}

// Capability labels describe the common executable contract, not roadmap
// intent. Provider-specific extensions must not silently raise these flags.
export function sqlSupportsSelect(): bool { return true }
export function sqlSupportsInsert(): bool { return true }
export function sqlSupportsUpdate(): bool { return true }
export function sqlSupportsDelete(): bool { return true }
export function sqlSupportsTransactions(): bool { return true }
export function sqlSupportsParameters(): bool { return true }
export function sqlSupportsSchemaMigration(): bool { return false }
export function sqlSupportsJoin(): bool { return false }
export function sqlSupportsGroupBy(): bool { return false }
export function sqlSupportsOrderBy(): bool { return true }
