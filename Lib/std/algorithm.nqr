module noqeri.std.algorithm

export function nqGcdI64(a: i64, b: i64): i64 {
    let left: i64 = a
    let right: i64 = b
    if left < 0 { left = -left }
    if right < 0 { right = -right }
    while right != 0 as i64 {
        let remainder: i64 = left % right
        left = right
        right = remainder
    }
    return left
}

export function nqLcmI64(a: i64, b: i64): i64 {
    if a == 0 as i64 || b == 0 as i64 { return 0 as i64 }
    let gcd: i64 = nqGcdI64(a, b)
    let value: i64 = (a / gcd) * b
    if value < 0 { return -value }
    return value
}

export function nqPowI64(base: i64, exponent: u32): i64 {
    let result: i64 = 1 as i64
    let index: u32 = 0 as u32
    while index < exponent {
        result = result * base
        index = index + 1 as u32
    }
    return result
}

export function nqFactorialU64(value: u32): u64 {
    let result: u64 = 1 as u64
    let index: u32 = 2 as u32
    while index <= value {
        result = result * index as u64
        index = index + 1 as u32
    }
    return result
}
