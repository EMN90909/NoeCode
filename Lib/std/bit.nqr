module noqeri.std.bit

export function nqBitIsSetU64(value: u64, bit: u32): bool {
    if bit >= 64 as u32 { return false }
    let mask: u64 = 1 as u64
    let index: u32 = 0 as u32
    while index < bit {
        mask = mask * 2 as u64
        index = index + 1 as u32
    }
    return (value / mask) % 2 as u64 == 1 as u64
}

export function nqBitCountU64(value: u64): u32 {
    let current: u64 = value
    let count: u32 = 0 as u32
    while current > 0 as u64 {
        if current % 2 as u64 == 1 as u64 { count = count + 1 as u32 }
        current = current / 2 as u64
    }
    return count
}

export function nqPowerOfTwoU64(value: u64): bool {
    if value == 0 as u64 { return false }
    let current: u64 = value
    while current % 2 as u64 == 0 as u64 {
        current = current / 2 as u64
    }
    return current == 1 as u64
}
