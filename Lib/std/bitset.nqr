module noqeri.std.bitset

export function bitset_len<T>(items: []T): usize { return len(items) }
export function bitset_is_empty<T>(items: []T): bool { return len(items) == 0 as usize }
export function bitset_first<T>(items: []T): T { return items[0] }
export function bitset_last<T>(items: []T): T { return items[len(items)-1] }
