module noqeri.std.bloom

export function bloom_len<T>(items: []T): usize { return len(items) }
export function bloom_is_empty<T>(items: []T): bool { return len(items) == 0 as usize }
export function bloom_first<T>(items: []T): T { return items[0] }
export function bloom_last<T>(items: []T): T { return items[len(items)-1] }
