module noqeri.std.buffer

export function buffer_capacity_valid(length: usize, capacity: usize): bool { return length <= capacity }
export function buffer_remaining(length: usize, capacity: usize): usize { if length >= capacity { return 0 as usize } return capacity - length }
export function buffer_nonempty(length: usize): bool { return length > 0 as usize }
export function buffer_checked_end(offset: usize, length: usize, capacity: usize): bool { if offset > capacity { return false } return length <= capacity - offset }
