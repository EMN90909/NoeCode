module noqeri.std.channel

extern function channelHostCreate(capacity: usize): usize
extern function channelHostSendI64(channel: usize, value: i64, timeoutMillis: i64): isize
extern function channelHostReceiveI64(channel: usize, timeoutMillis: i64): i64
extern function channelHostCount(channel: usize): usize
extern function channelHostClose(channel: usize): bool
extern function channelHostDestroy(channel: usize): bool

export function channel_open(): int { return 0 }
export function channel_waiting(): int { return 1 }
export function channel_ready(): int { return 2 }
export function channel_closed(): int { return 3 }
export function channel_failed(): int { return 4 }

export function channel_state_valid(state: int): bool { return state >= 0 && state <= 4 }
export function channel_can_transition(current: int, next: int): bool { if current < 0 || next < 0 { return false } return next >= current || next == channel_open() }
export function channel_default_spin_limit(): usize { return 64 as usize }
export function channel_bounded_count(count: usize, limit: usize): usize { if count > limit { return limit } return count }
export function channel_handle_valid(channel: usize): bool { return channel != 0 as usize }
export function channel_capacity_valid(capacity: usize): bool { return capacity > 0 as usize && capacity <= 1048576 as usize }
export function channel_timeout_valid(timeoutMillis: i64): bool { return timeoutMillis >= 0 as i64 }

export function channel_create(capacity: usize): usize {
    if !channel_capacity_valid(capacity) { return 0 as usize }
    unsafe { return channelHostCreate(capacity) }
}

export function channel_send_i64(channel: usize, value: i64, timeoutMillis: i64): isize {
    if !channel_handle_valid(channel) || !channel_timeout_valid(timeoutMillis) { return -1 }
    unsafe { return channelHostSendI64(channel, value, timeoutMillis) }
}

export function channel_receive_i64(channel: usize, timeoutMillis: i64): i64 {
    if !channel_handle_valid(channel) || !channel_timeout_valid(timeoutMillis) { return 0 as i64 }
    unsafe { return channelHostReceiveI64(channel, timeoutMillis) }
}

export function channel_count(channel: usize): usize {
    if !channel_handle_valid(channel) { return 0 as usize }
    unsafe { return channelHostCount(channel) }
}

export function channel_close(channel: usize): bool {
    if !channel_handle_valid(channel) { return false }
    unsafe { return channelHostClose(channel) }
}

export function channel_destroy(channel: usize): bool {
    if !channel_handle_valid(channel) { return false }
    unsafe { return channelHostDestroy(channel) }
}
