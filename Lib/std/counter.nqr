module noqeri.std.counter

export function nqCounterIncrement(value: usize): usize { return value + 1 }
export function nqCounterCanIncrement(value: usize, limit: usize): bool { return value < limit }
export function nqCounterRemaining(value: usize, limit: usize): usize {
    if value >= limit { return 0 as usize }
    return limit - value
}
