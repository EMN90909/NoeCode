module noqeri.std.debug

export function debug_ratio_per_mille(part: usize, total: usize): usize { if total == 0 as usize { return 0 as usize } return (part * 1000 as usize) / total }
export function debug_passed(passed: usize, failed: usize): bool { return failed == 0 as usize && passed > 0 as usize }
export function debug_delta(start: i64, end: i64): i64 { return end - start }
export function debug_clamp_sample(value: usize, max: usize): usize { if value > max { return max } return value }
