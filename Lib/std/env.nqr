module noqeri.std.env

extern function envHas(name: string): bool
extern function envGet(name: string): string
extern function envSet(name: string, value: string): isize
extern function envUnset(name: string): isize

export function env_has(name: string): bool { return envHas(name) }
export function env_get(name: string): string { return envGet(name) }
export function env_set(name: string, value: string): isize { return envSet(name,value) }
export function env_unset(name: string): isize { return envUnset(name) }
export function env_name_valid(name: string): bool { return textLength(name) > 0 as usize }
