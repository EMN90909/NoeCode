module noqeri.std.file

extern function fileOpen(path: string, flags: u32): isize
extern function fileClose(handle: usize): isize
extern function fileRead(handle: usize, data: *u8, count: usize): isize
extern function fileWrite(handle: usize, data: *u8, count: usize): isize
extern function fileSeek(handle: usize, offset: i64, origin: int): isize

export function file_open_read(path: string): isize { return fileOpen(path, 1 as u32) }
export function file_open_write(path: string): isize { return fileOpen(path, 2 as u32) }
export function file_close(handle: usize): isize { return fileClose(handle) }
export function file_read_into(handle: usize, buffer: []u8): isize { if len(buffer)==0 as usize { return 0 as isize } return fileRead(handle,&buffer[0],len(buffer)) }
export function file_write_from(handle: usize, buffer: []u8): isize { if len(buffer)==0 as usize { return 0 as isize } return fileWrite(handle,&buffer[0],len(buffer)) }
export function file_rewind(handle: usize): isize { return fileSeek(handle,0 as i64,0) }
export function file_status_ok(status: isize): bool { return status >= 0 as isize }
