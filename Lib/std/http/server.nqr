module noqeri.std.http.server

extern function httpServerListen(address: string, port: u32): isize
extern function httpServerAccept(server: usize): isize
extern function httpServerRespond(client: usize, status: int, body: string): isize
extern function httpServerClose(handle: usize): void

export function http_server_listen(address: string, port: u32): isize { if port == 0 as u32 || port > 65535 as u32 { throw 2 } return httpServerListen(address,port) }
export function http_server_accept(server: usize): isize { return httpServerAccept(server) }
export function http_server_respond(client: usize, status: int, body: string): isize { if status < 100 || status > 599 { throw 2 } return httpServerRespond(client,status,body) }
export function http_server_close(handle: usize): void { httpServerClose(handle) }
export function http_server_status_valid(status: int): bool { return status >= 100 && status <= 599 }
