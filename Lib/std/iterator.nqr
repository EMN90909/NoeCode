module noqeri.std.iterator

export function iterator_len<T>(items: []T): usize { return len(items) }
export function iterator_is_empty<T>(items: []T): bool { return len(items) == 0 as usize }
export function iterator_first<T>(items: []T): T { return items[0] }
export function iterator_last<T>(items: []T): T { return items[len(items)-1] }
