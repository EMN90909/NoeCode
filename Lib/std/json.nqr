module noqeri.std.json

unsafe extern function jsonHostDecode(typeName:string,text:string,target:usize):isize
unsafe extern function jsonHostEncode(typeName:string,source:usize):string

export function json_is_whitespace(c:u8):bool{return c==32 as u8||c==9 as u8||c==10 as u8||c==13 as u8}
export function json_is_digit(c:u8):bool{return c>=48 as u8&&c<=57 as u8}
export function json_is_value_start(c:u8):bool{return c==34 as u8||c==123 as u8||c==91 as u8||c==116 as u8||c==102 as u8||c==110 as u8||c==45 as u8||json_is_digit(c)}

export function json_skip_whitespace(text:[]u8,start:usize):usize {
    let index:usize=start
    while index<len(text)&&json_is_whitespace(text[index]){index=index+1 as usize}
    return index
}

export function json_string_end(text:[]u8,start:usize):usize {
    if start>=len(text)||text[start]!=34 as u8{return start}
    let index:usize=start+1 as usize
    while index<len(text){
        if text[index]==92 as u8 { index=index+2 as usize }
        else if text[index]==34 as u8 { return index+1 as usize }
        else if text[index]<32 as u8 { return start }
        else { index=index+1 as usize }
    }
    return start
}

export function json_literal_at(text:[]u8,start:usize,a:u8,b:u8,c:u8,end:u8):bool {
    if start+4 as usize>len(text){return false}
    return text[start]==a&&text[start+1 as usize]==b&&text[start+2 as usize]==c&&text[start+3 as usize]==end
}

export function json_number_end(text:[]u8,start:usize):usize {
    let index:usize=start
    if index<len(text)&&text[index]==45 as u8{index=index+1 as usize}
    if index>=len(text)||!json_is_digit(text[index]){return start}
    if text[index]==48 as u8{index=index+1 as usize}else{while index<len(text)&&json_is_digit(text[index]){index=index+1 as usize}}
    if index<len(text)&&text[index]==46 as u8{
        index=index+1 as usize
        if index>=len(text)||!json_is_digit(text[index]){return start}
        while index<len(text)&&json_is_digit(text[index]){index=index+1 as usize}
    }
    if index<len(text)&&(text[index]==101 as u8||text[index]==69 as u8){
        index=index+1 as usize
        if index<len(text)&&(text[index]==43 as u8||text[index]==45 as u8){index=index+1 as usize}
        if index>=len(text)||!json_is_digit(text[index]){return start}
        while index<len(text)&&json_is_digit(text[index]){index=index+1 as usize}
    }
    return index
}

// Structural validator used before typed decoding. It rejects malformed strings,
// mismatched containers and illegal control bytes without allocating.
export function validate(text:[]u8):bool {
    let index:usize=json_skip_whitespace(text,0 as usize)
    if index>=len(text)||!json_is_value_start(text[index]){return false}
    let objectDepth:int=0
    let arrayDepth:int=0
    let inString:bool=false
    let escaped:bool=false
    while index<len(text){
        let c:u8=text[index]
        if inString{
            if escaped{escaped=false}
            else if c==92 as u8{escaped=true}
            else if c==34 as u8{inString=false}
            else if c<32 as u8{return false}
        }else{
            if c==34 as u8{inString=true}
            else if c==123 as u8{objectDepth=objectDepth+1}
            else if c==125 as u8{objectDepth=objectDepth-1;if objectDepth<0{return false}}
            else if c==91 as u8{arrayDepth=arrayDepth+1}
            else if c==93 as u8{arrayDepth=arrayDepth-1;if arrayDepth<0{return false}}
        }
        index=index+1 as usize
    }
    return !inString&&!escaped&&objectDepth==0&&arrayDepth==0
}

// Until explicit call-site generic arguments land in the language grammar, the codec
// identifies record layouts by their stable type name and writes into caller-owned storage.
export function decode_into(typeName:string,text:string,target:usize):isize {
    if len(typeName)==0 as usize||len(text)==0 as usize||target==0 as usize{return -2 as isize}
    unsafe{return jsonHostDecode(typeName,text,target)}
}

export function encode_from(typeName:string,source:usize):string {
    if len(typeName)==0 as usize||source==0 as usize{return ""}
    unsafe{return jsonHostEncode(typeName,source)}
}

record JsonStream {
    text: []u8
    offset: usize
}

export function stream(text:[]u8):JsonStream{return JsonStream{text:text,offset:0 as usize}}
export function stream_done(reader:JsonStream):bool{return json_skip_whitespace(reader.text,reader.offset)>=len(reader.text)}
export function stream_offset(reader:JsonStream):usize{return reader.offset}
export function stream_advance(reader:JsonStream,count:usize):JsonStream{
    let next:usize=reader.offset+count
    if next>len(reader.text){next=len(reader.text)}
    return JsonStream{text:reader.text,offset:next}
}
