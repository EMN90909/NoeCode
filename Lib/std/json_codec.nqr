module noqeri.std.json_codec

// Runtime-backed JSON façade. Typed generic reflection will replace the string
// adapter once record metadata is available to the runtime.
extern function jsonEncode(value: string): string
extern function jsonDecode(text: string): string
extern function jsonStreamBegin(text: string): isize
extern function jsonStreamNext(stream: isize): string
extern function jsonStreamEnd(stream: isize): isize

export function encode(value: string): string { unsafe { return jsonEncode(value) } }
export function decode(text: string): string { unsafe { return jsonDecode(text) } }
export function stream_begin(text: string): isize { unsafe { return jsonStreamBegin(text) } }
export function stream_next(stream: isize): string { unsafe { return jsonStreamNext(stream) } }
export function stream_end(stream: isize): isize { unsafe { return jsonStreamEnd(stream) } }

export function is_whitespace(c: u8): bool { return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8 }
export function is_digit(c: u8): bool { return c >= 48 as u8 && c <= 57 as u8 }
export function is_value_start(c: u8): bool { return c == 34 as u8 || c == 123 as u8 || c == 91 as u8 || c == 116 as u8 || c == 102 as u8 || c == 110 as u8 || c == 45 as u8 || is_digit(c) }
