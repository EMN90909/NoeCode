module noqeri.std.math

export function abs_int(value: int): int { if value < 0 { return -value } return value }
export function min_int(a: int, b: int): int { if a < b { return a } return b }
export function max_int(a: int, b: int): int { if a > b { return a } return b }
export function clamp_int(value: int, low: int, high: int): int { if value < low { return low } if value > high { return high } return value }
export function sign_int(value: int): int { if value < 0 { return -1 } if value > 0 { return 1 } return 0 }
export function gcd_int(a: int, b: int): int { let x: int = abs_int(a) let y: int = abs_int(b) while y != 0 { let r: int = x % y x = y y = r } return x }
export function lcm_int(a: int, b: int): int { if a == 0 || b == 0 { return 0 } return abs_int((a / gcd_int(a,b)) * b) }
export function pow_int(base: int, exponent: u32): int { let result: int = 1 let b: int = base let e: u32 = exponent while e > 0 as u32 { if e % 2 as u32 == 1 as u32 { result = result * b } e = e / 2 as u32 if e > 0 as u32 { b = b * b } } return result }
export function sqrt_int(value: int): int { if value <= 0 { return 0 } let x: int = value let y: int = (x + 1) / 2 while y < x { x = y y = (x + value / x) / 2 } return x }
export function floor_float(value: float): int { let n: int = value as int if (n as float) > value { return n - 1 } return n }
export function ceil_float(value: float): int { let n: int = value as int if (n as float) < value { return n + 1 } return n }
export function round_float(value: float): int { if value >= 0.0 { return (value + 0.5) as int } return (value - 0.5) as int }
export function lerp_float(a: float, b: float, t: float): float { return a + (b - a) * t }
export function is_even(value: int): bool { return value % 2 == 0 }
export function is_odd(value: int): bool { return value % 2 != 0 }
export function checked_add_i64(a: i64, b: i64): isize { if b > 0 as i64 && a > 9223372036854775807 as i64 - b { throw 1 } if b < 0 as i64 && a < (-9223372036854775807 as i64 - 1 as i64) - b { throw 1 } return (a + b) as isize }
export function checked_sub_i64(a: i64, b: i64): isize { if b < 0 as i64 && a > 9223372036854775807 as i64 + b { throw 1 } if b > 0 as i64 && a < (-9223372036854775807 as i64 - 1 as i64) + b { throw 1 } return (a - b) as isize }
