module noqeri.std.math.big

export function big_digit_valid(value:u8):bool{return value<=9 as u8}
export function big_add_digit(a:u8,b:u8,carry:u8):u8{return (a+b+carry)%10 as u8}
export function big_add_carry(a:u8,b:u8,carry:u8):u8{return (a+b+carry)/10 as u8}
export function big_sub_digit(a:u8,b:u8,borrow:u8):u8{let av:int=a as int let bv:int=(b+borrow) as int if av<bv{return (av+10-bv) as u8}return (av-bv) as u8}
export function big_sub_borrow(a:u8,b:u8,borrow:u8):u8{if (a as int)<((b+borrow) as int){return 1 as u8}return 0 as u8}
export function big_mul_digit(a:u8,b:u8,carry:u8):u8{return ((a as u32)*(b as u32)+(carry as u32))%10 as u32 as u8}
export function big_mul_carry(a:u8,b:u8,carry:u8):u8{return (((a as u32)*(b as u32)+(carry as u32))/10 as u32) as u8}
export function big_compare_length(a:usize,b:usize):int{if a<b{return -1}if a>b{return 1}return 0}
export function big_digits_valid(value:[]u8):bool{let i:usize=0 as usize while i<len(value){if !big_digit_valid(value[i]){return false}i=i+1}return true}
