module noqeri.std.numeric

export function numeric_sum_i64(items: []i64): i64 { let total: i64=0 as i64 let i: usize=0 as usize while i<len(items) { total=total+items[i] i=i+1 } return total }
export function numeric_min_i64(items: []i64): i64 { let best:i64=items[0] let i:usize=1 as usize while i<len(items) { if items[i]<best { best=items[i] } i=i+1 } return best }
export function numeric_max_i64(items: []i64): i64 { let best:i64=items[0] let i:usize=1 as usize while i<len(items) { if items[i]>best { best=items[i] } i=i+1 } return best }
export function numeric_mean_i64(items: []i64): i64 { if len(items)==0 as usize { return 0 as i64 } return numeric_sum_i64(items)/(len(items) as i64) }
