module noqeri.std.pool

export function pool_capacity_valid(length: usize, capacity: usize): bool { return length <= capacity }
export function pool_remaining(length: usize, capacity: usize): usize { if length >= capacity { return 0 as usize } return capacity - length }
export function pool_nonempty(length: usize): bool { return length > 0 as usize }
export function pool_checked_end(offset: usize, length: usize, capacity: usize): bool { if offset > capacity { return false } return length <= capacity - offset }
