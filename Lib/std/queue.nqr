module noqeri.std.queue
export function queue_len<T>(items: []T): usize { return len(items) }
export function queue_is_empty<T>(items: []T): bool { return len(items) == 0 as usize }
export function queue_front<T>(items: []T): T { return items[0] }
export function queue_back<T>(items: []T): T { return items[len(items)-1] }
