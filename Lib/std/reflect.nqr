module noqeri.std.reflect

export function reflect_clamp(value: int, low: int, high: int): int { if value < low { return low } if value > high { return high } return value }
export function reflect_between(value: int, low: int, high: int): bool { return value >= low && value <= high }
export function reflect_min(a: int, b: int): int { if a < b { return a } return b }
export function reflect_max(a: int, b: int): int { if a > b { return a } return b }
