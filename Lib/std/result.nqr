module noqeri.std.result

// Result<T> is the application-facing error carrier. The low-level ABI may keep
// negative status codes, but library APIs can pair a value with an explicit
// error code without sentinel values or nullable success paths.
record Result<T> {
    value: T
    error: isize
    ok: bool
}

export function result_ok<T>(value: T): Result<T> {
    let result: Result<T>
    result.value = value
    result.error = 0 as isize
    result.ok = true
    return result
}

export function result_error<T>(fallback: T, error: isize): Result<T> {
    let result: Result<T>
    result.value = fallback
    result.error = error
    result.ok = false
    return result
}

export function result_is_ok<T>(result: *Result<T>): bool { return result.ok }
export function result_is_error<T>(result: *Result<T>): bool { return !result.ok }
export function result_value_or<T>(result: *Result<T>, fallback: T): T { if result.ok { return result.value } return fallback }
export function result_error_or<T>(result: *Result<T>, fallback: isize): isize { if result.ok { return fallback } return result.error }

export function result_from_status<T>(value: T, fallback: T, status: isize): Result<T> {
    if status < 0 as isize { return result_error(fallback, status) }
    return result_ok(value)
}

// Low-level compatibility helpers remain for freestanding/ABI code.
export function result_status_ok(status: isize): bool { return status >= 0 as isize }
export function result_status_error(status: isize): bool { return status < 0 as isize }
export function result_error_code(status: isize): isize { if status < 0 as isize { return -status } return 0 as isize }
export function result_attempt_allowed(attempt: usize, max_attempts: usize): bool { return attempt < max_attempts }
