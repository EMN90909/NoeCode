module noqeri.std.retry

record RetryPolicy {
    maxAttempts: usize
    baseDelayMillis: u64
    maxDelayMillis: u64
    multiplierPermille: u64
    jitterPermille: u64
}

export function retry_status_ok(status: isize): bool { return status >= 0 as isize }
export function retry_status_error(status: isize): bool { return status < 0 as isize }
export function retry_error_code(status: isize): isize { if status < 0 as isize { return -status } return 0 as isize }
export function retry_attempt_allowed(attempt: usize, max_attempts: usize): bool { return attempt < max_attempts }

export function retry_policy_default(out: *RetryPolicy): void {
    out.maxAttempts = 5 as usize
    out.baseDelayMillis = 100 as u64
    out.maxDelayMillis = 10000 as u64
    out.multiplierPermille = 2000 as u64
    out.jitterPermille = 200 as u64
}

export function retry_policy_valid(policy: *RetryPolicy): bool {
    if policy == null { return false }
    if policy.maxAttempts == 0 as usize { return false }
    if policy.baseDelayMillis > policy.maxDelayMillis { return false }
    if policy.multiplierPermille < 1000 as u64 || policy.multiplierPermille > 100000 as u64 { return false }
    if policy.jitterPermille > 1000 as u64 { return false }
    return true
}

export function retry_saturating_mul_div(value: u64, multiplier: u64, divisor: u64, limit: u64): u64 {
    if divisor == 0 as u64 { return limit }
    if value == 0 as u64 || multiplier == 0 as u64 { return 0 as u64 }
    if value > limit { return limit }
    // Noqeri integer literals are currently parsed through the signed 64-bit
    // literal path, so stay inside that range instead of spelling UINT64_MAX.
    if value > 9223372036854775807 as u64 / multiplier { return limit }
    let scaled: u64 = value * multiplier
    let result: u64 = scaled / divisor
    if result > limit { return limit }
    return result
}

export function retry_delay_for_attempt(policy: *RetryPolicy, attempt: usize): u64 {
    if !retry_policy_valid(policy) { return 0 as u64 }
    let delay: u64 = policy.baseDelayMillis
    let i: usize = 0 as usize
    while i < attempt {
        delay = retry_saturating_mul_div(delay, policy.multiplierPermille, 1000 as u64, policy.maxDelayMillis)
        if delay >= policy.maxDelayMillis { return policy.maxDelayMillis }
        i = i + 1 as usize
    }
    return delay
}

// Small deterministic LCG confined below 2^32 so the intermediate multiply
// cannot overflow u64. Security-sensitive randomness must use std/crypto.
export function retry_mix_seed(seed: u64): u64 {
    let modulus: u64 = 4294967291 as u64
    let value: u64 = seed % modulus
    return (value * 1664525 as u64 + 1013904223 as u64) % modulus
}

export function retry_delay_with_jitter(policy: *RetryPolicy, attempt: usize, seed: u64): u64 {
    let base: u64 = retry_delay_for_attempt(policy, attempt)
    if base == 0 as u64 || policy.jitterPermille == 0 as u64 { return base }
    let span: u64 = retry_saturating_mul_div(base, policy.jitterPermille, 1000 as u64, policy.maxDelayMillis)
    if span == 0 as u64 { return base }
    let modulus: u64 = 4294967291 as u64
    let combined: u64 = (seed % modulus + attempt as u64 % modulus) % modulus
    let random: u64 = retry_mix_seed(combined)
    let width: u64 = span * 2 as u64 + 1 as u64
    let offset: u64 = random % width
    if offset <= span {
        let decrease: u64 = span - offset
        if decrease > base { return 0 as u64 }
        return base - decrease
    }
    let increase: u64 = offset - span
    if increase > policy.maxDelayMillis { return policy.maxDelayMillis }
    if base > policy.maxDelayMillis - increase { return policy.maxDelayMillis }
    return base + increase
}

export function retry_is_transient_http(status: int): bool {
    return status == 408 || status == 425 || status == 429 || status == 500 || status == 502 || status == 503 || status == 504
}

export function retry_is_transient_status(status: isize): bool {
    if status >= 0 as isize { return false }
    let code: isize = retry_error_code(status)
    return code == 11 as isize || code == 35 as isize || code == 110 as isize || code == 111 as isize || code == 10060 as isize || code == 10061 as isize
}

export function retry_should_continue(policy: *RetryPolicy, attempt: usize, status: isize): bool {
    return retry_policy_valid(policy) && retry_status_error(status) && retry_attempt_allowed(attempt + 1 as usize, policy.maxAttempts)
}
