module noqeri.std.scheduler

record SchedulerPolicy {
    quantum: usize
    yieldEvery: usize
    maxSpins: usize
    maxBatch: usize
}

record SchedulerTicket {
    state: int
    priority: int
    submittedMillis: i64
    deadlineMillis: i64
    sequence: u64
}

export function scheduler_pending(): int { return 0 }
export function scheduler_ready(): int { return 1 }
export function scheduler_running(): int { return 2 }
export function scheduler_completed(): int { return 3 }
export function scheduler_cancelled(): int { return 4 }

export function scheduler_state_valid(state: int): bool { return state >= scheduler_pending() && state <= scheduler_cancelled() }
export function scheduler_terminal(state: int): bool { return state == scheduler_completed() || state == scheduler_cancelled() }
export function scheduler_can_transition(current: int, next: int): bool {
    if !scheduler_state_valid(current) || !scheduler_state_valid(next) { return false }
    if current == scheduler_pending() { return next == scheduler_ready() || next == scheduler_cancelled() }
    if current == scheduler_ready() { return next == scheduler_running() || next == scheduler_cancelled() }
    if current == scheduler_running() { return next == scheduler_ready() || next == scheduler_completed() || next == scheduler_cancelled() }
    return false
}

export function scheduler_default_spin_limit(): usize { return 64 as usize }
export function scheduler_bounded_count(count: usize, limit: usize): usize { if count > limit { return limit } return count }

export function scheduler_policy_default(out: *SchedulerPolicy): void {
    out.quantum = 64 as usize
    out.yieldEvery = 16 as usize
    out.maxSpins = 256 as usize
    out.maxBatch = 1024 as usize
}

export function scheduler_policy_valid(policy: *SchedulerPolicy): bool {
    if policy == null { return false }
    return policy.quantum > 0 as usize && policy.yieldEvery > 0 as usize && policy.maxSpins > 0 as usize && policy.maxBatch > 0 as usize
}

export function scheduler_ticket_init(ticket: *SchedulerTicket, priority: int, submittedMillis: i64, deadlineMillis: i64, sequence: u64): void {
    ticket.state = scheduler_pending()
    ticket.priority = priority
    ticket.submittedMillis = submittedMillis
    ticket.deadlineMillis = deadlineMillis
    ticket.sequence = sequence
}

export function scheduler_ticket_expired(ticket: *SchedulerTicket, nowMillis: i64): bool {
    return ticket.deadlineMillis > 0 as i64 && nowMillis >= ticket.deadlineMillis
}

export function scheduler_ticket_can_run(ticket: *SchedulerTicket, nowMillis: i64): bool {
    return !scheduler_ticket_expired(ticket, nowMillis) && (ticket.state == scheduler_ready() || ticket.state == scheduler_running())
}

export function scheduler_ticket_transition(ticket: *SchedulerTicket, next: int): bool {
    if !scheduler_can_transition(ticket.state, next) { return false }
    ticket.state = next
    return true
}

export function scheduler_compare(ticketA: *SchedulerTicket, ticketB: *SchedulerTicket): int {
    if ticketA.priority > ticketB.priority { return -1 }
    if ticketA.priority < ticketB.priority { return 1 }
    if ticketA.deadlineMillis > 0 as i64 && ticketB.deadlineMillis > 0 as i64 {
        if ticketA.deadlineMillis < ticketB.deadlineMillis { return -1 }
        if ticketA.deadlineMillis > ticketB.deadlineMillis { return 1 }
    } else if ticketA.deadlineMillis > 0 as i64 { return -1 }
    else if ticketB.deadlineMillis > 0 as i64 { return 1 }
    if ticketA.sequence < ticketB.sequence { return -1 }
    if ticketA.sequence > ticketB.sequence { return 1 }
    return 0
}

export function scheduler_quantum_for_priority(policy: *SchedulerPolicy, priority: int): usize {
    if !scheduler_policy_valid(policy) { return 1 as usize }
    if priority <= 0 { return policy.quantum }
    let bonus: usize = priority as usize
    if bonus > 8 as usize { bonus = 8 as usize }
    if policy.quantum > policy.maxBatch / (bonus + 1 as usize) { return policy.maxBatch }
    let result: usize = policy.quantum * (bonus + 1 as usize)
    if result > policy.maxBatch { return policy.maxBatch }
    return result
}

export function scheduler_should_yield(policy: *SchedulerPolicy, workUnits: usize): bool {
    if !scheduler_policy_valid(policy) { return true }
    return workUnits > 0 as usize && workUnits % policy.yieldEvery == 0 as usize
}

export function scheduler_spin_budget(policy: *SchedulerPolicy, contention: usize): usize {
    if !scheduler_policy_valid(policy) { return 0 as usize }
    let budget: usize = 1 as usize
    let i: usize = 0 as usize
    while i < contention && budget < policy.maxSpins {
        if budget > policy.maxSpins / 2 as usize { return policy.maxSpins }
        budget = budget * 2 as usize
        i = i + 1 as usize
    }
    if budget > policy.maxSpins { return policy.maxSpins }
    return budget
}

export function scheduler_batch_size(policy: *SchedulerPolicy, readyCount: usize): usize {
    if !scheduler_policy_valid(policy) { return 0 as usize }
    let count: usize = readyCount
    if count > policy.maxBatch { count = policy.maxBatch }
    return count
}
