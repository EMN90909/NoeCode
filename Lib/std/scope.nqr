module noqeri.std.scope

extern function scopeHostCreate(timeoutMillis: i64): usize
extern function scopeHostSpawn(scope: usize, entry: string, payload: string): usize
extern function scopeHostCancel(scope: usize): bool
extern function scopeHostJoin(scope: usize): isize
extern function scopeHostDestroy(scope: usize): bool

export function scope_handle_valid(scope: usize): bool { return scope != 0 as usize }
export function scope_timeout_valid(timeoutMillis: i64): bool { return timeoutMillis >= 0 as i64 }

// A scope owns every task spawned through it. `scope_join` must not return
// success until all children have reached a terminal state. Cancelling a scope
// propagates cancellation to every live child before join completes.
export function scope_create(timeoutMillis: i64): usize {
    if !scope_timeout_valid(timeoutMillis) { return 0 as usize }
    unsafe { return scopeHostCreate(timeoutMillis) }
}

export function scope_spawn(scope: usize, entry: string, payload: string): usize {
    if !scope_handle_valid(scope) { return 0 as usize }
    unsafe { return scopeHostSpawn(scope, entry, payload) }
}

export function scope_cancel(scope: usize): bool {
    if !scope_handle_valid(scope) { return false }
    unsafe { return scopeHostCancel(scope) }
}

export function scope_join(scope: usize): isize {
    if !scope_handle_valid(scope) { return -1 }
    unsafe { return scopeHostJoin(scope) }
}

export function scope_destroy(scope: usize): bool {
    if !scope_handle_valid(scope) { return false }
    unsafe { return scopeHostDestroy(scope) }
}
