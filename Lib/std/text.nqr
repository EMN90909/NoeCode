module noqeri.std.text

export function nqTextIsEmpty(value: string): bool {
    return textLength(value) == 0
}

export function nqTextHasLength(value: string, expected: int): bool {
    return textLength(value) == expected
}

export function nqTextJoin2(left: string, right: string): string {
    return left + right
}

export function nqTextJoin3(first: string, second: string, third: string): string {
    return first + second + third
}

export function nqTextEquals(left: string, right: string): bool {
    return left == right
}
