module noqeri.std.time

export function time_seconds_to_millis(value: i64): i64 { return value * 1000 as i64 }
export function time_minutes_to_seconds(value: i64): i64 { return value * 60 as i64 }
export function time_hours_to_seconds(value: i64): i64 { return value * 3600 as i64 }
export function time_days_to_seconds(value: i64): i64 { return value * 86400 as i64 }
