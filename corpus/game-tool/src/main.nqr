function reflect(position: int, velocity: int): int {
    if position < 0 || position > 1000 { return -velocity }
    return velocity
}

function main(): int {
    let x: int = 10
    let y: int = 20
    let vx: int = 3
    let vy: int = 2
    let health: int = 100
    let frame: int = 0

    while frame < 10000 {
        x = x + vx
        y = y + vy
        vx = reflect(x, vx)
        vy = reflect(y, vy)
        frame = frame + 1
    }

    if health != 100 { return 1 }
    if frame != 10000 { return 2 }
    return 0
}
