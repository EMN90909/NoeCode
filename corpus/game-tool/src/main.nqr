record Actor {
    x: int,
    y: int,
    vx: int,
    vy: int,
    health: int
}

function step(actor: Actor): Actor {
    let next: Actor = actor
    next.x = next.x + next.vx
    next.y = next.y + next.vy
    if next.x < 0 || next.x > 1000 { next.vx = -next.vx }
    if next.y < 0 || next.y > 1000 { next.vy = -next.vy }
    return next
}

function main(): int {
    let actor: Actor = Actor { x: 10, y: 20, vx: 3, vy: 2, health: 100 }
    let frame: int = 0
    while frame < 10000 {
        actor = step(actor)
        frame = frame + 1
    }
    if actor.health != 100 { return 1 }
    return 0
}
