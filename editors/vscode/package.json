{
  "name": "noqeri-language",
  "displayName": "noqeri Language",
  "description": "Language support for noqeri (.nqr)",
  "version": "1.0.0",
  "publisher": "noqeri-lang",
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Programming Languages", "Themes", "Snippets"],
  "activationEvents": [],
  "contributes": {
    "languages": [{"id": "noqeri", "aliases": ["noqeri", "NQR"], "extensions": [".nqr"], "configuration": "./language-configuration.json"}],
    "grammars": [{"language": "noqeri", "scopeName": "source.nqr", "path": "./syntaxes/noqeri.tmLanguage.json"}],
    "snippets": [{"language":"noqeri","path":"./snippets/noqeri.json"}],
    "iconThemes": [{"id": "noqeri-icons", "label": "noqeri File Icons", "path": "./icons/icon-theme.json"}]
  }
}
