import "../../Lib/std/json.nqr"

function require(ok: bool): void {
    if !ok { print("ASSERT-FAIL") }
}

let payload: [u8; 11] = [123 as u8, 34 as u8, 111 as u8, 107 as u8, 34 as u8, 58 as u8, 116 as u8, 114 as u8, 117 as u8, 101 as u8, 125 as u8]
require(json_token_count(slice(payload)) == 5 as isize)

let number: [u8; 8] = [45 as u8, 49 as u8, 50 as u8, 46 as u8, 53 as u8, 101 as u8, 43 as u8, 50 as u8]
require(json_number_end(slice(number), 0 as usize) == 8 as isize)

let invalidEscape: [u8; 4] = [34 as u8, 97 as u8, 92 as u8, 120 as u8]
require(json_string_end(slice(invalidEscape), 0 as usize) < 0 as isize)

print("json-service: ok")
