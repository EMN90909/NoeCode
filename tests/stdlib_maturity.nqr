import "../Lib/std/math.nqr"
import "../Lib/std/math/big.nqr"
import "../Lib/std/math/checked.nqr"
import "../Lib/std/math/advanced.nqr"
import "../Lib/std/path.nqr"
import "../Lib/std/result.nqr"
import "../Lib/std/random.nqr"
import "../Lib/std/bytes.nqr"
import "../Lib/std/time.nqr"
import "../Lib/std/string.nqr"
import "../Lib/std/list.nqr"
import "../Lib/std/map.nqr"
import "../Lib/std/set.nqr"

function main(): int {
    if nqGcdI64(462 as i64, 1071 as i64) != 21 as i64 { return 1 }
    if nqIntegerSqrtU64(1849 as u64) != 43 as u64 { return 2 }
    if !nqIsPrimeI64(7919 as i64) { return 3 }
    if result_encode_error(7 as isize) != -8 as isize { return 4 }
    if result_error_code(-8 as isize) != 7 as isize { return 5 }

    let unix: [u8; 16] = [47 as u8,104 as u8,111 as u8,109 as u8,101 as u8,47 as u8,110 as u8,111 as u8,113 as u8,101 as u8,114 as u8,105 as u8,47 as u8,97 as u8,46 as u8,110 as u8]
    let unixView: []u8 = slice(unix)
    if !path_is_absolute(unixView) { return 6 }
    if path_filename_offset(unixView) != 13 as usize { return 7 }
    if path_extension_offset(unixView) != 14 as isize { return 8 }
    if path_component_count(unixView) != 3 as usize { return 9 }

    let component: [u8; 6] = [110 as u8,111 as u8,113 as u8,101 as u8,114 as u8,105 as u8]
    if !path_is_safe_component(slice(component)) { return 10 }
    let parent: [u8; 2] = [46 as u8,46 as u8]
    if path_is_safe_component(slice(parent)) { return 11 }

    let seed: u64 = 12345 as u64
    if random_range(seed, 10 as u64, 20 as u64) < 10 as u64 { return 12 }
    if random_range(seed, 10 as u64, 20 as u64) >= 20 as u64 { return 13 }

    let bytesA: [u8; 4] = [65 as u8,66 as u8,67 as u8,68 as u8]
    let bytesB: [u8; 2] = [67 as u8,68 as u8]
    if !nqBytesEndsWith(slice(bytesA), slice(bytesB)) { return 14 }
    if nqBytesIndexOf(slice(bytesA), 67 as u8) != 2 as isize { return 15 }
    if nqBytesCompare(slice(bytesA), slice(bytesA)) != 0 { return 16 }

    let bigLeft: [u8; 3] = [9 as u8,9 as u8,9 as u8]
    let bigRight: [u8; 1] = [1 as u8]
    let bigOut: [u8; 4] = [0 as u8,0 as u8,0 as u8,0 as u8]
    if big_add_into(slice(bigOut), slice(bigLeft), slice(bigRight)) != 4 as usize { return 17 }
    if bigOut[0 as usize] != 0 as u8 || bigOut[1 as usize] != 0 as u8 || bigOut[2 as usize] != 0 as u8 || bigOut[3 as usize] != 1 as u8 { return 18 }

    if time_hour_part(90061 as i64) != 1 as i64 { return 19 }
    if time_minute_part(90061 as i64) != 1 as i64 { return 20 }
    if time_second_part(90061 as i64) != 1 as i64 { return 21 }
    if string_repeat("ab", 3 as usize) != "ababab" { return 22 }
    if string_center("x", 3 as usize, "-") != "-x-" { return 23 }

    let checked: i64 = 0 as i64
    if !checked_add_i64(40 as i64, 2 as i64, &checked) || checked != 42 as i64 { return 24 }
    if checked_add_i64(checked_i64_max(), 1 as i64, &checked) { return 25 }
    if !nqAlmostEqualFloat(nqAtanFloat(1.0), nqPi() / 4.0, 0.0001) { return 26 }
    if !nqAlmostEqualFloat(nqAsinFloat(1.0), nqPi() / 2.0, 0.0001) { return 27 }

    return 0
}
