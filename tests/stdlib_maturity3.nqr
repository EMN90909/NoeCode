import "../Lib/std/concurrency.nqr"
import "../Lib/std/retry.nqr"
import "../Lib/std/scheduler.nqr"
import "../Lib/std/timezone.nqr"
import "../Lib/std/validation.nqr"
import "../Lib/std/markdown.nqr"
import "../Lib/std/toml.nqr"
import "../Lib/std/yaml.nqr"
import "../Lib/std/uri.nqr"

function test_concurrency(): int {
    let token: CancellationToken
    cancellation_init(&token)
    if cancellation_is_requested(&token) { return 1 }
    if !cancellation_request(&token) || !cancellation_is_requested(&token) { return 2 }

    let latch: Latch
    latch_init(&latch, 2 as u64)
    if latch_ready(&latch) { return 3 }
    if latch_count_down(&latch) { return 4 }
    if !latch_count_down(&latch) || !latch_ready(&latch) { return 5 }

    let group: TaskGroup
    task_group_init(&group)
    task_group_spawned(&group)
    task_group_spawned(&group)
    task_group_finished(&group)
    task_group_failed_with(&group, 17 as isize)
    if !task_group_done(&group) || task_group_completed(&group) != 1 as u64 || task_group_failed(&group) != 1 as u64 || task_group_first_error(&group) != 17 as isize { return 6 }

    let gate: BackpressureGate
    backpressure_init(&gate, 2 as u64)
    if !backpressure_try_enter(&gate) || !backpressure_try_enter(&gate) || backpressure_try_enter(&gate) { return 7 }
    if backpressure_available(&gate) != 0 as u64 || !backpressure_leave(&gate) || backpressure_available(&gate) != 1 as u64 { return 8 }
    return 0
}

function test_retry_scheduler(): int {
    let policy: RetryPolicy
    retry_policy_default(&policy)
    if !retry_policy_valid(&policy) || retry_delay_for_attempt(&policy, 0 as usize) != 100 as u64 || retry_delay_for_attempt(&policy, 3 as usize) != 800 as u64 { return 1 }
    let jitter: u64 = retry_delay_with_jitter(&policy, 2 as usize, 123 as u64)
    if jitter < 320 as u64 || jitter > 480 as u64 { return 2 }
    if !retry_is_transient_http(503) || retry_is_transient_http(404) { return 3 }

    let scheduler: SchedulerPolicy
    scheduler_policy_default(&scheduler)
    if !scheduler_policy_valid(&scheduler) || scheduler_quantum_for_priority(&scheduler, 1) != 128 as usize { return 4 }
    if !scheduler_should_yield(&scheduler, 16 as usize) || scheduler_should_yield(&scheduler, 17 as usize) { return 5 }
    let first: SchedulerTicket
    let second: SchedulerTicket
    scheduler_ticket_init(&first, 2, 0 as i64, 100 as i64, 1 as u64)
    scheduler_ticket_init(&second, 1, 0 as i64, 50 as i64, 2 as u64)
    if scheduler_compare(&first, &second) != -1 { return 6 }
    if !scheduler_ticket_transition(&first, scheduler_ready()) || !scheduler_ticket_can_run(&first, 10 as i64) { return 7 }
    return 0
}

function test_timezone_validation(): int {
    if !timezone_offset_valid(50400 as i64) || timezone_offset_valid(50460 as i64) { return 1 }
    let output: [u8; 6] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    if timezone_format_offset(19800 as i64, slice(output)) != 6 as isize { return 2 }
    if output[0 as usize] != 43 as u8 || output[1 as usize] != 48 as u8 || output[2 as usize] != 53 as u8 || output[3 as usize] != 58 as u8 || output[4 as usize] != 51 as u8 || output[5 as usize] != 48 as u8 { return 3 }

    let identifier: [u8; 8] = [78 as u8,111 as u8,113 as u8,101 as u8,114 as u8,105 as u8,95 as u8,49 as u8]
    if !validation_ascii_identifier(slice(identifier)) { return 4 }
    let host: [u8; 11] = [101 as u8,120 as u8,97 as u8,109 as u8,112 as u8,108 as u8,101 as u8,46 as u8,99 as u8,111 as u8,109 as u8]
    if !validation_hostname(slice(host)) { return 5 }
    return 0
}

function test_format_scanners(): int {
    let markdownLine: [u8; 4] = [35 as u8,32 as u8,72 as u8,105 as u8]
    let markdown: MarkdownLine
    if !markdown_scan_line(slice(markdownLine), &markdown) || markdown.kind != markdown_heading() || markdown.level != 1 as usize || markdown.contentStart != 2 as usize { return 1 }

    let tomlLine: [u8; 8] = [97 as u8,103 as u8,101 as u8,32 as u8,61 as u8,32 as u8,52 as u8,50 as u8]
    let toml: TomlLine
    if !toml_scan_line(slice(tomlLine), &toml) || toml.kind != toml_key_value() || toml.keyLength != 3 as usize || toml.valueLength != 2 as usize { return 2 }

    let yamlLine: [u8; 6] = [45 as u8,32 as u8,105 as u8,116 as u8,101 as u8,109 as u8]
    let yaml: YamlLine
    if !yaml_scan_line(slice(yamlLine), &yaml) || yaml.kind != yaml_sequence() || yaml.valueLength != 4 as usize { return 3 }

    let uriValue: [u8; 30] = [104 as u8,116 as u8,116 as u8,112 as u8,115 as u8,58 as u8,47 as u8,47 as u8,101 as u8,120 as u8,97 as u8,109 as u8,112 as u8,108 as u8,101 as u8,46 as u8,99 as u8,111 as u8,109 as u8,47 as u8,97 as u8,37 as u8,50 as u8,48 as u8,98 as u8,63 as u8,120 as u8,61 as u8,49 as u8,35 as u8]
    let uri: UriParts
    if !uri_parse(slice(uriValue), &uri) || !uri.absolute || uri.scheme.length != 5 as usize || uri.authority.length != 11 as usize || uri.query.length != 3 as usize { return 4 }
    let encoded: [u8; 5] = [97 as u8,37 as u8,50 as u8,48 as u8,98 as u8]
    let decoded: [u8; 3] = [0 as u8,0 as u8,0 as u8]
    if uri_percent_decode(slice(encoded), slice(decoded)) != 3 as isize || decoded[0 as usize] != 97 as u8 || decoded[1 as usize] != 32 as u8 || decoded[2 as usize] != 98 as u8 { return 5 }
    return 0
}

function main(): int {
    let result: int = test_concurrency()
    if result != 0 { return 10 + result }
    result = test_retry_scheduler()
    if result != 0 { return 30 + result }
    result = test_timezone_validation()
    if result != 0 { return 50 + result }
    result = test_format_scanners()
    if result != 0 { return 70 + result }
    return 0
}
