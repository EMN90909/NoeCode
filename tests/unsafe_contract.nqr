// Conformance target for the explicit unsafe boundary.
// The raw pointer dereference and cast are intentionally contained.

function load_i64(pointer: *i64): i64 {
    unsafe {
        return *pointer
    }
}

function pointer_roundtrip(pointer: *i64): *i64 {
    unsafe {
        let address: usize = pointer as usize
        return address as *i64
    }
}

function safe_identity(value: int): int {
    return value
}
